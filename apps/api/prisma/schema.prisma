// Omniva database schema. Migrations are forward-only and expand–contract
// (CODING_STANDARDS §6); row-level security policies live in hand-written SQL inside the
// migration that adds each workspace-owned table (ADR 0009, ADR 0016). The application acts as
// the omniva_app role, which those policies always apply to (the application_database_role
// migration); migrations run as the owner of the tables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & Access ─────────────────────────────────────────────────────────────────────
// Better Auth's tables (ADR 0016). Field names follow Better Auth; columns are snake_case.

/// A human who signs in to Omniva.
model User {
  id            String   @id
  /// Better Auth requires a name; Omniva asks for none at sign-up, so it starts empty.
  name          String
  email         String   @unique
  emailVerified Boolean  @map("email_verified")
  image         String?
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  sessions    Session[]
  credentials UserCredential[]
  memberships Member[]

  @@map("user")
}

/// A signed-in session. PostgreSQL is the source of truth for sessions (spec, D3).
model Session {
  id        String   @id
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// How a User proves who they are: for now only email and password. Better Auth calls this
/// an "account"; in Omniva an Account is only ever a financial account (GLOSSARY.md).
model UserCredential {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("provider_subject_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_credential")
}

/// Short-lived tokens Better Auth issues, such as password-reset links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ── Workspaces & Membership ───────────────────────────────────────────────────────────────

enum WorkspaceKind {
  personal
  shared

  @@map("workspace_kind")
}

enum MemberRole {
  owner
  editor
  viewer

  @@map("member_role")
}

/// The space that owns a set of records (ADR 0002).
model Workspace {
  id                  String        @id @default(uuid())
  kind                WorkspaceKind
  /// Set only on a personal workspace, so each User has exactly one.
  personalOwnerUserId String?       @unique @map("personal_owner_user_id")
  createdAt           DateTime      @default(now()) @map("created_at")

  members            Member[]
  records            Record[]
  activityEntries    ActivityEntry[]
  keyDates           KeyDate[]
  reminderNotices    ReminderNotice[]
  reminderDeliveries ReminderDelivery[]
  reminderHandlings  ReminderHandling[]

  @@map("workspace")
}

/// A User's participation in a workspace, represented there by a Person record.
model Member {
  id             String     @id @default(uuid())
  workspaceId    String     @map("workspace_id")
  userId         String     @map("user_id")
  role           MemberRole
  personRecordId String     @unique @map("person_record_id")
  createdAt      DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    Record    @relation(fields: [personRecordId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("member")
}

// ── Records core ──────────────────────────────────────────────────────────────────────────

/// The ten building blocks every record is built from (GLOSSARY.md).
enum Block {
  item
  document
  money_record
  obligation
  event
  task
  person
  note
  plan
  measurement

  @@map("block")
}

/// The twelve life areas that give records a home (GLOSSARY.md, Module).
enum LifeModule {
  productivity
  finance
  health
  knowledge
  career
  assets
  social
  travel
  home
  subscriptions
  documents
  entertainment

  @@map("life_module")
}

/// Where a record stands in its own life, by building block (GLOSSARY.md).
enum LifecycleState {
  owned
  disposed
  active
  ending
  ended
  valid
  expired
  open
  done
  upcoming
  in_progress
  past

  @@map("lifecycle_state")
}

/// Any single entry in Omniva (ADR 0001). The shared anatomy sits in fixed columns; the
/// Type-specific fields sit in `fields`, validated against the Type definition (ADR 0011).
model Record {
  id             String          @id @default(uuid())
  workspaceId    String          @map("workspace_id")
  block          Block
  /// The record's Type, which decides its home module.
  typeKey        String          @map("type_key")
  homeModule     LifeModule      @map("home_module")
  title          String
  /// Null for a building block with no lifecycle, such as a Person.
  lifecycleState LifecycleState? @map("lifecycle_state")
  isArchived     Boolean         @default(false) @map("is_archived")
  fields         Json            @default("{}")
  /// The record's reminder rules, which start as its Type's defaults: `[{ keyDateField, daysBefore }]`.
  reminderRules  Json            @default("[]") @map("reminder_rules")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member             Member?
  activityEntries    ActivityEntry[]
  keyDates           KeyDate[]
  reminderNotices    ReminderNotice[]
  reminderDeliveries ReminderDelivery[]
  reminderHandlings  ReminderHandling[]

  @@index([workspaceId])
  @@index([workspaceId, homeModule])
  @@map("record")
}

// ── History ───────────────────────────────────────────────────────────────────────────────

/// What happened to a record, as the Activity Timeline tells it.
enum ActivityAction {
  created
  updated
  archived
  unarchived

  @@map("activity_action")
}

/// One change on the Activity Timeline, written in the same transaction as the change itself
/// (ADR 0008). It refers to the record rather than copying its content (ADR 0004).
model ActivityEntry {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  recordId    String?        @map("record_id")
  action      ActivityAction
  /// The user who made the change; null when Omniva made it. A user, not a Member, because
  /// "created by" is history and outlives the membership (ADR 0002).
  actorUserId String?        @map("actor_user_id")
  occurredAt  DateTime       @map("occurred_at")
  /// Orders entries that share an occurredAt, in the order they were written. The database's
  /// own clock, never shown; numbering them from a sequence would make them guessable.
  recordedAt  DateTime       @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamp(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record    Record?   @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([recordId])
  @@map("activity_entry")
}

// ── Key dates ─────────────────────────────────────────────────────────────────────────────

enum KeyDatePrecision {
  exact
  month
  missing

  @@map("key_date_precision")
}

/// The one collection of Key dates, maintained by Records core whenever a record's date fields
/// change; reminders, the calendar and the Overview read only from it (ADR 0008). It is derived
/// from the records' own fields, so it can always be rebuilt.
model KeyDate {
  id                 String           @id @default(uuid())
  workspaceId        String           @map("workspace_id")
  recordId           String           @map("record_id")
  /// Which of the record's date fields this is, such as `registrationExpiresOn`.
  fieldKey           String           @map("field_key")
  precision          KeyDatePrecision
  /// The exact day, or the first of the month for a month-only date; null when missing.
  date               DateTime?        @db.Date
  /// How many days before the date each of its reminder rules reminds.
  reminderDaysBefore Int[]            @default([]) @map("reminder_days_before")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record    Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, fieldKey])
  @@index([workspaceId, date])
  @@map("key_date")
}

// ── Scheduling & Reminders ────────────────────────────────────────────────────────────────

/// What the user did about a Key date's reminder (GLOSSARY.md, Handled, Snoozed).
enum ReminderHandlingStatus {
  handled
  snoozed

  @@map("reminder_handling_status")
}

/// The derived schedule of due notices (ADR 0012): rebuilt from Key dates, their reminder
/// rules, the deliveries and the user's handling, so it can be emptied and rebuilt at any time.
model ReminderNotice {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  recordId    String   @map("record_id")
  fieldKey    String   @map("field_key")
  /// The Key date's day when the notice was scheduled; another day is another occurrence.
  occursOn    DateTime @map("occurs_on") @db.Date
  daysBefore  Int      @map("days_before")
  remindOn    DateTime @map("remind_on") @db.Date
  lapsesOn    DateTime @map("lapses_on") @db.Date

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record    Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, fieldKey, occursOn, daysBefore], map: "reminder_notice_once")
  @@index([remindOn])
  @@index([workspaceId, remindOn])
  @@map("reminder_notice")
}

/// Every due notice delivered, under its unique key, so no retry delivers it twice (ADR 0012).
model ReminderDelivery {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  recordId    String    @map("record_id")
  fieldKey    String    @map("field_key")
  occursOn    DateTime  @map("occurs_on") @db.Date
  daysBefore  Int       @map("days_before")
  /// Urgent reminders are emailed; the others wait for the digest.
  isUrgent    Boolean   @map("is_urgent")
  /// When it reached the app, which is as soon as it is recorded.
  deliveredAt DateTime  @map("delivered_at")
  /// When an urgent reminder's email went through; null until it has.
  emailedAt   DateTime? @map("emailed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record    Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, fieldKey, occursOn, daysBefore], map: "reminder_delivery_once")
  @@index([workspaceId, recordId])
  @@map("reminder_delivery")
}

/// What the user did about a Key date's reminder, for the day the date had then.
model ReminderHandling {
  id           String                 @id @default(uuid())
  workspaceId  String                 @map("workspace_id")
  recordId     String                 @map("record_id")
  fieldKey     String                 @map("field_key")
  occursOn     DateTime               @map("occurs_on") @db.Date
  status       ReminderHandlingStatus
  snoozedUntil DateTime?              @map("snoozed_until") @db.Date
  changedAt    DateTime               @map("changed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record    Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, fieldKey, occursOn], map: "reminder_handling_once")
  @@index([workspaceId])
  @@map("reminder_handling")
}
