  "info": {
    "title": "Omniva API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "components": {
            "type": "object",
            "properties": {
              "api": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "redis": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "worker": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              }
            },
            "required": [
              "api",
              "database",
              "redis",
              "worker"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checkedAt",
          "components"
        ],
        "additionalProperties": false
      },
      "ActivityEntry": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "archived",
              "unarchived"
            ]
          },
          "actorUserId": {
            "nullable": true,
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "action",
          "actorUserId",
          "occurredAt"
        ],
        "additionalProperties": false
      },
      "RecordHistory": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityEntry"
            }
          }
        },
        "required": [
          "entries"
        ],
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "CurrentSession": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "id",
              "email"
            ],
            "additionalProperties": false
          },
          "personalWorkspace": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "editor",
                  "viewer"
                ]
              },
              "mePersonId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "role",
              "mePersonId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "user",
          "personalWorkspace"
        ],
        "additionalProperties": false
      },
      "EmailVerificationRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "SignUpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "RecordFields": {
        "type": "object",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "TypeKey": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "CreateRecordRequest": {
        "type": "object",
        "properties": {
          "typeKey": {
            "$ref": "#/components/schemas/TypeKey"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fields": {
            "$ref": "#/components/schemas/RecordFields"
          }
        },
        "required": [
          "typeKey",
          "title",
          "fields"
        ],
        "additionalProperties": false
      },
      "LifeModule": {
        "type": "string",
        "enum": [
          "productivity",
          "finance",
          "health",
          "knowledge",
          "career",
          "assets",
          "social",
          "travel",
          "home",
          "subscriptions",
          "documents",
          "entertainment"
        ]
      },
      "RecordId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "LifecycleState": {
        "type": "string",
        "enum": [
          "owned",
          "disposed",
          "active",
          "ending",
          "ended",
          "valid",
          "expired",
          "open",
          "done",
          "upcoming",
          "in_progress",
          "past"
        ]
      },
      "Record": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/RecordId"
          },
          "typeKey": {
            "$ref": "#/components/schemas/TypeKey"
          },
          "title": {
            "type": "string"
          },
          "homeModule": {
            "$ref": "#/components/schemas/LifeModule"
          },
          "lifecycleState": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/LifecycleState"
              }
            ]
          },
          "isArchived": {
            "type": "boolean"
          },
          "fields": {
            "$ref": "#/components/schemas/RecordFields"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "typeKey",
          "title",
          "homeModule",
          "lifecycleState",
          "isArchived",
          "fields",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "RecordList": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          }
        },
        "required": [
          "records"
        ],
        "additionalProperties": false
      },
      "Block": {
        "type": "string",
        "enum": [
          "item",
          "document",
          "money_record",
          "obligation",
          "event",
          "task",
          "person",
          "note",
          "plan",
          "measurement"
        ]
      },
      "FieldKey": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "FieldDefinition": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/FieldKey"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "date"
            ]
          }
        },
        "required": [
          "key",
          "kind"
        ],
        "additionalProperties": false
      },
      "ReminderRule": {
        "type": "object",
        "properties": {
          "keyDateField": {
            "$ref": "#/components/schemas/FieldKey"
          },
          "daysBefore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "keyDateField",
          "daysBefore"
        ],
        "additionalProperties": false
      },
      "TypeDefinition": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/TypeKey"
          },
          "block": {
            "$ref": "#/components/schemas/Block"
          },
          "homeModule": {
            "$ref": "#/components/schemas/LifeModule"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            }
          },
          "keyDateFields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldKey"
            }
          },
          "defaultReminderRules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReminderRule"
            }
          }
        },
        "required": [
          "key",
          "block",
          "homeModule",
          "fields",
          "keyDateFields",
          "defaultReminderRules"
        ],
        "additionalProperties": false
      },
      "TypeList": {
        "type": "object",
        "properties": {
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TypeDefinition"
            }
          }
        },
        "required": [
          "types"
        ],
        "additionalProperties": false
      },
      "UpdateRecordRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fields": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RecordFields"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "WorkspaceId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/WorkspaceId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "personal",
              "shared"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "viewer"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "role"
        ],
        "additionalProperties": false
      }
    }
  }
}
