{
  "name": "@omniva/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm run --parallel \"/^dev:/\"",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:api": "node --watch --env-file=../../.env.example --env-file-if-exists=../../.env dist/main.js",
    "dev:worker": "node --watch --env-file=../../.env.example --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "serve": "pnpm build && node scripts/serve.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "openapi:generate": "pnpm build && node dist/openapi/write-openapi-document.js",
    "test:seam1": "vitest run --config vitest.seam1.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@omniva/schemas": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.27",
    "ioredis": "6.1.0",
    "nodemailer": "10.6.1",
    "pg": "^8.23.1",
    "pg-boss": "12.39.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@omniva/api-client": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}
