# Local development only. These values match docker-compose.yml and hold no secrets.
# Copy to .env to override. Real secrets live only in the managed secrets store (repo is public).
DATABASE_URL=postgresql://omniva:omniva@localhost:55432/omniva
REDIS_URL=redis://localhost:56379
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
SMTP_URL=smtp://localhost:51025
# Development only. Every deployed environment sets its own secret in the secrets store.
AUTH_SECRET=local-development-secret-not-for-any-deployed-environment
